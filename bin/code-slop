#!/usr/bin/env python3
"""code-slop: find AI-authorship tells in a diff, with no model.

The whole slop toolchain in this kit reads PROSE. ai-scan reads vocabulary,
slop-check reads structure, prose-check reads the house list. Every one of them
scores a README and none of them has ever looked at a line of code.

Code has its own tells and they are not the same ones. A reviewer who spots
`// loop over the entries` above a for loop stops reading the code and starts
hunting for more, which is the actual cost: slop is a trust problem, not a style
problem. The rules here come from Carlton Aikins' `deslop` skill
(github.com/31Carlton7/skills, MIT), which is installed alongside this and holds
the judgement calls. This is the deterministic half: it runs first, for free, so
the model is only spent on what actually fired.

    code-slop                     the working tree against HEAD
    code-slop --range HEAD~3..    a commit range
    code-slop file.ts file.py     whole files, not a diff
    code-slop --issues            show every hit with line numbers
    code-slop --max 20            exit 1 above that score
    code-slop --json              machine-readable

DENSITY IS REPORTED, NOT SCORED, and that is deliberate. This repo's house style
is high-comment on purpose: review-discipline.md requires a constant to carry
the incident that set it, and a header stating why beats a header stating what.
Carlton's skill says the same thing in its own words, that for
undocumented-protocol code the comments ARE the spec and each one is judged by
the keep and delete lists rather than by count. A scanner that failed this
codebase for commenting would be red on every run, and slop-check already
learned where that ends: a checker that is always red gets ignored.
"""

import argparse
import json
import re
import subprocess
import sys

# (id, weight, explanation, pattern). Matched against comment TEXT, lowercased,
# with the comment marker already stripped.
#
# Every pattern here is a comment that tells the reader something the line below
# it already says. That is Carlton's Pass 1 in one sentence: a comment must
# state a constraint the code cannot show.
RULES = [
    (
        "narration",
        12,
        "narrates the next line: say why, or delete it",
        re.compile(
            r"^(?:loop|iterate)\s+(?:over|through)\b"
            r"|^call\s+(?:the\s+|our\s+)?\w+"
            r"|^return\s+(?:the|a|an)\s+\w+\s*$"
            r"|^(?:get|set|create|build|make|add|remove|delete|update|check|validate|parse|format|convert|initialize|init|assign|declare|define|import|export)\s+(?:the|a|an)\s+"
            r"|^(?:start|begin|end)\s+of\s+(?:the\s+)?\w+"
            # A SEQUENCER NEEDS AN IMPERATIVE VERB BEHIND IT. Matching
            # "first|then|next" plus any word called "First run takes a bounded
            # window" and "FIRST, EVERY CONNECTION GETS A ROW" narration, and
            # both are constraints: one bounds a 600k-row backfill, the other
            # states an invariant. Narration says "First, get the user". The
            # verb is the whole difference, so the verb is required.
            r"|^(?:now|then|first|next|finally),?\s+(?:we\s+)?"
            r"(?:get|set|create|build|make|add|remove|delete|update|check|"
            r"validate|parse|format|convert|call|return|loop|iterate|assign|"
            r"declare|define|initialize|init|handle|process|send|fetch|read|"
            r"write|store|save|load|open|close|start|stop)\b"
        ),
    ),
    (
        "reviewer-talk",
        15,
        "defends the diff instead of informing the reader: belongs in the PR body",
        re.compile(
            r"\bthis\s+is\s+safe\s+because\b"
            r"|^note\s+that\b"
            r"|\bas\s+(?:mentioned|noted|discussed)\s+(?:above|below|earlier)\b"
            r"|\bwe\s+(?:already\s+)?(?:checked|verified|ensured)\b"
            r"|\bto\s+be\s+safe\b"
            r"|\bjust\s+to\s+be\s+(?:sure|safe)\b"
        ),
    ),
    (
        "review-reference",
        15,
        "references the PR, the review or the conversation: the next reader has none of that",
        re.compile(
            r"\b(?:per|as\s+requested\s+in|from)\s+(?:the\s+)?(?:review|pr\b|feedback|comment)"
            r"|\brecently\s+(?:changed|added|updated|renamed)\b"
            r"|\b(?:fixed|changed|added|updated)\s+(?:in|as\s+part\s+of)\s+(?:this\s+)?(?:pr\b|commit|diff|change)"
            r"|\bsee\s+pr\s*#?\d"
            r"|\bthis\s+(?:pr|commit|diff)\b"
        ),
    ),
    (
        "self-reference",
        10,
        "describes itself rather than the constraint",
        re.compile(
            r"^this\s+(?:function|method|class|variable|constant|file|module|helper)\s+"
            r"|^helper\s+(?:function\s+)?to\s+"
            r"|^(?:a\s+)?(?:utility|convenience)\s+(?:function|wrapper|helper)\b"
        ),
    ),
    (
        "banner",
        8,
        "section banner: structure a file under ~300 lines with functions, not signposts",
        re.compile(r"^[-=*_#~]{3,}\s*$|^[-=*_#~]{2,}[^-=*_#~]+[-=*_#~]{2,}$"),
    ),
    (
        "placeholder",
        20,
        "left-behind scaffolding",
        # AN OWNED MARKER IS EXEMPT. `TODO(caleb)` names somebody, which makes
        # it tracked work rather than something the generation left behind, and
        # that is the distinction this rule is drawing. A bare `TODO` names
        # nobody and will be read by nobody.
        re.compile(
            r"^(?:todo|fixme|xxx|hack)\b(?!\s*\([^)]+\))"
            r"|\byour\s+(?:code|logic|implementation)\s+here\b"
            r"|\bimplement\s+(?:this|me)\b"
            r"|\b(?:rest|more)\s+of\s+the\s+(?:code|logic|implementation)\b"
        ),
    ),
]

# How a comment opens, per language family. The value is the group that holds
# the comment text.
LINE_COMMENT = re.compile(r"^\s*(?://+|#+|--|;;?|\*|/\*+)\s?(.*?)\s*(?:\*/)?\s*$")

# Files whose "comments" are prose, where none of this applies.
PROSE_SUFFIX = (".md", ".mdx", ".txt", ".rst", ".json", ".lock", ".sums")

# A `#!` line, a coding declaration, a linter directive, a type pragma. These
# open like comments and are machine-readable instructions, never narration.
DIRECTIVE = re.compile(
    r"^(?:!|-\*-|\s*(?:@ts-|eslint|prettier|ruff|noqa|pylint|type:|mypy|flake8|"
    r"shellcheck|secret-scan|coding[:=]|global\b|pragma\b|swiftlint|nolint))",
    re.I,
)


def comment_text(line):
    """The prose inside a comment, or None when the line is not one.

    A trailing comment on a line of code (`x = 1  # why`) is deliberately not
    matched: those are almost always the constraint-stating kind, and scanning
    them turned every `# noqa` and every `}  // end if` into a finding without
    surfacing anything real.
    """
    m = LINE_COMMENT.match(line)
    if not m:
        return None
    text = m.group(1).strip()
    if not text or DIRECTIVE.match(text):
        return None
    return text


# Rules anchored at the start of a comment. A comment is a BLOCK of consecutive
# lines, not one line per finding, and these may only be tested against a
# block's FIRST line.
#
# The scanner found this in its own author's work on the first real run. A
# wrapped paragraph reading "...the case the old SOFT list was written for /
# first name would go. This is..." put "first name would go" at the start of a
# line, where the narration pattern matched it. Judged per line, every prose
# paragraph that happens to wrap onto "then", "next" or "first" is a finding,
# which is the false-positive rate that gets a checker switched off.
FIRST_LINE_ONLY = {"narration", "self-reference"}


def is_marker(text):
    """A real TODO is a marker, not a sentence that opens with the word.

    `// TODO`, `// TODO: parse the tail`, `// FIXME(caleb)` are markers. This
    file's own comment explaining the rule opens a wrapped line with "TODO is a
    discrete piece of unfinished work, and collapsing it into a", which is
    prose, and the scanner reported it against itself on the first full run.

    A marker is short, or it is punctuated. Prose is neither.
    """
    return len(text) <= 60 or bool(re.match(r"^\W*\w+\s*[:(]", text))


def scan_lines(lines, path):
    """lines is a list of (lineno, text). Returns findings and a comment count."""
    findings = []
    comments = 0
    code = 0

    # (lineno, text) for the comment block currently being accumulated.
    block = []

    def add(rid, weight, why, no, text):
        findings.append(
            {
                "file": path,
                "line": no,
                "rule": rid,
                "weight": weight,
                "why": why,
                "text": text[:120],
            }
        )

    def flush():
        if not block:
            return
        first_no, first_text = block[0]
        # A PLACEHOLDER IS ALWAYS ITS OWN FINDING. Every other rule describes the
        # block's character, so one verdict per block is right. A left-behind
        # TODO is a discrete piece of unfinished work, and collapsing it into a
        # neighbouring comment hides it: the first version of this reported a
        # section banner and silently dropped the TODO on the line below it.
        for ln, txt in block:
            for rid, weight, why, pat in RULES:
                if rid == "placeholder" and pat.search(txt.lower()) and is_marker(txt):
                    add(rid, weight, why, ln, txt)

        # One verdict for the block, and it is the WORST match rather than the
        # first one listed, because RULES is ordered for reading and not by
        # weight.
        best = None
        for rid, weight, why, pat in RULES:
            if rid == "placeholder":
                continue
            if rid in FIRST_LINE_ONLY:
                hit, no = (first_text, first_no) if pat.search(first_text.lower()) else (None, None)
            else:
                hit = no = None
                for ln, txt in block:
                    if pat.search(txt.lower()):
                        hit, no = txt, ln
                        break
            if hit is not None and (best is None or weight > best[1]):
                best = (rid, weight, why, no, hit)
        if best:
            add(*best)
        block.clear()

    for no, raw in lines:
        text = comment_text(raw)
        if text is None:
            flush()
            if raw.strip():
                code += 1
            continue
        comments += 1
        block.append((no, text))
    flush()
    return findings, comments, code


def from_diff(range_arg):
    """Added lines only. A diff is the unit of review, so it is the unit here."""
    cmd = ["git", "diff", "--unified=0", "--no-color"]
    cmd += [range_arg] if range_arg else ["HEAD"]
    try:
        out = subprocess.run(
            cmd, capture_output=True, text=True, check=True
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        sys.exit(f"code-slop: cannot read the diff ({exc})")

    files = {}
    path = None
    lineno = 0
    for line in out.splitlines():
        if line.startswith("+++ b/"):
            path = line[6:]
            files.setdefault(path, [])
        elif line.startswith("@@"):
            m = re.search(r"\+(\d+)", line)
            lineno = int(m.group(1)) if m else 0
        elif line.startswith("+") and not line.startswith("+++") and path:
            files[path].append((lineno, line[1:]))
            lineno += 1
    return {p: v for p, v in files.items() if not p.endswith(PROSE_SUFFIX)}


def from_files(paths):
    files = {}
    for p in paths:
        if p.endswith(PROSE_SUFFIX):
            continue
        try:
            with open(p, encoding="utf-8", errors="replace") as fh:
                files[p] = list(enumerate(fh.read().splitlines(), 1))
        except OSError as exc:
            sys.exit(f"code-slop: {p}: {exc}")
    return files


def main():
    ap = argparse.ArgumentParser(
        prog="code-slop", description="AI-authorship tells in code, no model."
    )
    ap.add_argument("paths", nargs="*", help="files to scan whole; default is the diff")
    ap.add_argument("--range", help="a git range, e.g. HEAD~3.. or main..HEAD")
    ap.add_argument("--issues", action="store_true", help="show every hit")
    ap.add_argument("--max", type=int, help="exit 1 above this score")
    ap.add_argument("--json", action="store_true", dest="as_json")
    args = ap.parse_args()

    files = from_files(args.paths) if args.paths else from_diff(args.range)
    if not files:
        print("code-slop: nothing to scan")
        return 0

    findings, comments, code = [], 0, 0
    for path, lines in files.items():
        f, cm, cd = scan_lines(lines, path)
        findings += f
        comments += cm
        code += cd

    # Score is the pattern hits only. Density never contributes: see the module
    # docstring for why.
    score = sum(f["weight"] for f in findings)
    density = (comments / (comments + code)) if (comments + code) else 0.0

    if args.as_json:
        print(
            json.dumps(
                {
                    "score": score,
                    "findings": findings,
                    "comment_lines": comments,
                    "code_lines": code,
                    "density": round(density, 3),
                },
                indent=2,
            )
        )
    else:
        unit = "files" if args.paths else "the diff"
        print(f"  code-slop {unit}: score {score}, {len(findings)} findings")
        print(
            f"  {comments} comment lines to {code} code lines"
            f" ({density:.0%}). Density is context, not a verdict:"
            " judge each comment by whether it states a constraint."
        )
        if args.issues:
            for f in sorted(findings, key=lambda x: (-x["weight"], x["file"], x["line"])):
                print(f"\n  {f['file']}:{f['line']}  {f['rule']}")
                print(f"    {f['why']}")
                print(f"    > {f['text']}")
        elif findings:
            seen = {}
            for f in findings:
                seen[f["rule"]] = seen.get(f["rule"], 0) + 1
            print("  " + ", ".join(f"{k} x{v}" for k, v in sorted(seen.items())))
            print("  run with --issues for lines, or load the deslop skill to fix")

    if args.max is not None and score > args.max:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
