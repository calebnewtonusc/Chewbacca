#!/bin/sh
# Find every kit on this machine.
#
# A kit is a repo somebody lives inside for weeks while an agent walks them
# through a process. Building one is only half the loop: a kit that cannot be
# discovered is a kit that gets rebuilt, or worse, gets ignored while the agent
# answers the same question turn by turn in a chat window.
#
# So every kit carries a .kit marker at its root, and this finds them.
#
# Usage:
#   kits              human-readable list
#   kits --context    one line for a session hook
#   kits --paths      just the directories
#
# Searches, in order: $KITS_DIR, $REPO_DIR, ~/dev, ~/Desktop, ~/Projects, ~/kits.
# Set KITS_DIR to override. Depth-limited, so a deep node_modules cannot slow it.

MODE="${1:-list}"

ROOTS="${KITS_DIR:-} ${REPO_DIR:-} $HOME/dev $HOME/Desktop $HOME/Projects $HOME/kits"

FOUND=""
for root in $ROOTS; do
  [ -n "$root" ] || continue
  [ -d "$root" ] || continue
  # maxdepth 4 reaches ~/Desktop/2026-Code/projects/<kit>/.kit and no further.
  for m in $(find "$root" -maxdepth 4 -name '.kit' -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null); do
    case " $FOUND " in *" $m "*) continue ;; esac
    FOUND="$FOUND $m"
  done
done

if [ -z "$FOUND" ]; then
  [ "$MODE" = "--context" ] && exit 0
  echo "No kits found."
  echo "Build one from https://github.com/calebnewtonusc/kit-template, or load the kit-builder skill."
  exit 0
fi

field() { grep -m1 "^$2:" "$1" 2>/dev/null | sed "s/^$2: *//"; }

case "$MODE" in
  --paths)
    for m in $FOUND; do dirname "$m"; done
    ;;
  --context)
    # One line, for injection into a session. This runs on EVERY session start,
    # so it is capped: an unbounded list would quietly cost more context every
    # time somebody builds another kit. Templates and half-built kits are
    # excluded so nobody is routed into an empty spine.
    OUT=""; SHOWN=0; TOTAL=0
    for m in $FOUND; do
      st=$(field "$m" status)
      [ "$st" = "template" ] && continue
      n=$(field "$m" name)
      case "$n" in ""|*"{{"*) continue ;; esac
      TOTAL=$((TOTAL + 1))
      [ "$SHOWN" -ge 6 ] && continue
      u=$(field "$m" use-when)
      # Trim each use-when to the first few phrases. Matching needs enough to
      # recognise the domain, not the whole list.
      u=$(printf '%s' "$u" | cut -c1-90)
      # ~-relative keeps the line short; the agent can expand it.
      d=$(dirname "$m"); d="~${d#$HOME}"
      OUT="$OUT$n [$d] $u. "
      SHOWN=$((SHOWN + 1))
    done
    if [ -n "$OUT" ]; then
      MORE=""
      [ "$TOTAL" -gt "$SHOWN" ] && MORE="Plus $((TOTAL - SHOWN)) more; run kits to see them. "
      printf 'Kits on this machine: %s%sIf what they are asking for matches one, cd there and work inside it rather than answering turn by turn. If it matches none and the work is kit-shaped, load kit-builder.\n' "$OUT" "$MORE"
    fi
    exit 0
    ;;
  *)
    echo ""
    for m in $FOUND; do
      n=$(field "$m" name); dm=$(field "$m" domain); s=$(field "$m" status); d=$(dirname "$m")
      printf "  %-22s %s\n" "${n:-$(basename "$d")}" "${s:-ready}"
      [ -n "$dm" ] && printf "  %-22s %s\n" "" "$dm"
      printf "  %-22s %s\n\n" "" "$d"
    done
    ;;
esac
