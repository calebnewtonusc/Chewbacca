#!/usr/bin/env python3
"""Find credentials committed as literals.

The kit's old CI checked three vendor prefixes: sk-ant-api, ghp_, ak_. A live
Todoist token sat in .claude/commands/*.md for 149 days and none of them
matched, because a Todoist token is forty bare hex characters and looks exactly
like a git commit SHA. Prefix matching cannot tell those apart.

So match on context instead of on shape. A secret is a long literal sitting
where a credential goes: after Bearer, after Authorization:, or assigned to a
name that says token, key, secret, or password. A commit SHA quoted in a doc is
never in one of those positions, which is what keeps this quiet enough to run
on every push.
"""
import pathlib
import re
import sys

CRED_CONTEXT = re.compile(
    r"""(?xi)
    (?: Bearer \s+                                  # Authorization: Bearer <v>
      | Authorization \s* [:=] \s* ["']? (?:Bearer\s+)?
      | (?: api[_-]?key | apikey | access[_-]?token  # KEY=<v>, "token": "<v>"
          | auth[_-]?token | secret[_-]?key | token
          | password | passwd | secret )
        ["']? \s* [:=] \s* ["']?
    )
    ([A-Za-z0-9_\-./+]{20,})                        # the literal itself
    """
)

# A value is fine if it is a reference, a placeholder, or an obvious example.
SAFE = re.compile(
    r"""(?xi)
    # An env lookup is a reference, not a value: process.env.X, os.environ[X],
    # os.getenv(X), import.meta.env.X.
    ^(?: process\.env | os\.environ | os\.getenv | import\.meta\.env | env\. )
    | ^(?: \$ | \{\{ | %s | <              # $VAR, {{var}}, %s, <fill-in>
       | your[_-] | my[_-] | example | placeholder | changeme | redacted
       | xxx | \.\.\. | dummy | sample | test[_-]?token | fake
       | none | null | true | false
    )
    | (?: _here | _goes_here )$
    # Case-sensitive on purpose. Under (?i) this alternative matched any
    # word-shaped string, including the forty lowercase hex characters of
    # the token it was supposed to catch.
    | ^(?-i:[A-Z][A-Z0-9_]{6,})$        # bare env var name, e.g. TODOIST_API_TOKEN
    """
)

ALLOW = "secret-scan: allow"

SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "dist", "build"}
SKIP_SUFFIX = {".lock", ".png", ".jpg", ".jpeg", ".gif", ".pdf", ".zip", ".ico"}


def looks_like_secret(value: str) -> bool:
    if SAFE.search(value):
        return False
    # Needs enough character classes to be a credential rather than a sentence
    # fragment, a URL path, or a package version.
    classes = sum(
        bool(re.search(p, value)) for p in (r"[a-z]", r"[A-Z]", r"[0-9]")
    )
    if len(value) >= 32 and re.fullmatch(r"[0-9a-f]{32,}", value):
        return True  # hex secret: Todoist, many webhook signing keys
    return classes >= 2 and len(value) >= 24


def scan(root: pathlib.Path):
    hits = []
    for path in root.rglob("*"):
        if not path.is_file():
            continue
        if SKIP_DIRS & set(path.parts) or path.suffix.lower() in SKIP_SUFFIX:
            continue
        try:
            text = path.read_text(errors="ignore")
        except OSError:
            continue
        for lineno, line in enumerate(text.splitlines(), 1):
            # An escape hatch that has to be written on the offending line, so
            # it cannot silently cover a file someone later adds a real key to.
            if ALLOW in line:
                continue
            for m in CRED_CONTEXT.finditer(line):
                value = m.group(1)
                if looks_like_secret(value):
                    shown = value[:6] + "..." + value[-4:]
                    hits.append(f"{path}:{lineno}: credential literal {shown}")
    return hits


if __name__ == "__main__":
    target = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else ".")
    found = scan(target)
    for h in found:
        print(h)
    if found:
        print(f"\n{len(found)} credential literal(s). Move each to an env var.")
        sys.exit(1)
    print("no credential literals found")
