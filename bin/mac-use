#!/usr/bin/env bash
# mac-use: one-shot macOS UI agent powered by browser-use/macOS-use.
# Chewbacca owns the provider adapters; macOS-use supplies the runtime/venv.
set -euo pipefail

export ANONYMIZED_TELEMETRY="${ANONYMIZED_TELEMETRY:-false}"

MACOS_USE="${MACOS_USE_HOME:-$HOME/Projects/macOS-use}"
PY="$MACOS_USE/.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "mac-use: macOS-use venv missing at $MACOS_USE/.venv" >&2
  echo "  run: chewbacca setup --only tools" >&2
  exit 1
fi

# Resolve this launcher, including ~/.local/bin symlinks. Another checkout's
# chewbacca command on PATH must never redirect provider ownership.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
CHEWBACCA_ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"

CLI="$CHEWBACCA_ROOT/bin/mac_use_cli.py"
[ -f "$CLI" ] || {
  echo "mac-use: provider CLI missing at $CLI" >&2
  exit 1
}

export PYTHONPATH="$CHEWBACCA_ROOT/bin${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" "$CLI" "$@"
