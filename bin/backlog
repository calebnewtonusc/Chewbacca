#!/usr/bin/env python3
"""What this kit decided to do, surviving the session that decided it.

    backlog                 the Now block, which is what SessionStart injects
    backlog all             every item
    backlog done            what shipped
    backlog dead            what was killed, and why
    backlog inbox           what was asked and is not an item yet
    backlog <search>        matching rows

Caleb, 2026-09-21: "how is chewbacca storing during session important context?
I feel like ur gonna forget the to dos we set at the beginning of this session?"

He was right. ~/.chewbacca/session-state/ records which files a session WROTE.
Nothing recorded what a session DECIDED, so every intent lived in one context
window and died with it.

BACKLOG.md is the store. It lives in the team's private repo, not the public
one, because a backlog names people, clients and deals. `backlog` reads it from
$CHEWBACCA_PRIVATE, else ~/chewbacca-private, else a BACKLOG.md beside this
checkout (a fork keeping its own). With none of those it says so and exits 0,
so a fresh public install and the session briefing are both quiet.
"""
import json, os, re, sys, pathlib

ROOT = pathlib.Path(__file__).resolve().parent.parent


def backlog_file():
    for base in (os.environ.get("CHEWBACCA_PRIVATE"), pathlib.Path.home() / "chewbacca-private", ROOT):
        if base and (pathlib.Path(base) / "BACKLOG.md").is_file():
            return pathlib.Path(base) / "BACKLOG.md"
    return None


FILE = backlog_file()


def sections():
    """Split on H2, keeping order. Returns [(title, [lines])]."""
    if FILE is None:
        print("No backlog on this machine. It lives in the private repo, see `backlog --help`.")
        sys.exit(0)
    out, cur, buf = [], None, []
    for line in FILE.read_text(encoding="utf-8").split("\n"):
        if line.startswith("## "):
            if cur:
                out.append((cur, buf))
            cur, buf = line[3:].strip(), []
        elif cur:
            buf.append(line)
    if cur:
        out.append((cur, buf))
    return out


def rows(lines):
    """Table rows only, skipping the header and the ---|--- separator."""
    for l in lines:
        if not l.startswith("|"):
            continue
        cells = [c.strip() for c in l.strip().strip("|").split("|")]
        if not cells or set("".join(cells)) <= set("- "):
            continue
        if cells[0] in ("#", "Item"):
            continue
        yield cells


def show(title, lines, width=96):
    got = list(rows(lines))
    if not got:
        return 0
    print(f"\n  {title}")
    for cells in got:
        # Numbered tables lead with #; Done and Dead do not.
        num = cells[0] if cells[0].isdigit() else ""
        item = cells[1] if num else cells[0]
        status = cells[2] if len(cells) > 2 and num else (cells[1] if len(cells) > 1 else "")
        item = re.sub(r"\*\*(.+?)\*\*", r"\1", item)
        item = re.sub(r"`(.+?)`", r"\1", item)
        head = f"  {num:>3} " if num else "      "
        print(f"{head}{item[:width - 14]:<{width - 14}} {status[:9]}")
    return len(got)


def inbox(limit=40):
    """Requests captured by the hook that no backlog row mentions yet.

    Caleb, 2026-09-21: "bro were you ignoring all my texts in this chat??? ...
    Things should NEVER be lost within a chat." Five requests that day were
    answered and never recorded. ask-capture.sh writes every prompt here; this
    is the part that says which ones never became work.

    Matching is deliberately crude: a request counts as captured when the
    backlog mentions enough of its distinctive words. It errs toward showing
    something twice rather than dropping it, because a duplicate costs a glance
    and a miss costs the thing itself.
    """
    store = pathlib.Path.home() / ".chewbacca" / "asks.jsonl"
    if not store.is_file():
        print("  nothing captured yet")
        return 0
    text = FILE.read_text(encoding="utf-8").lower() if FILE else ""
    stop = {"the","and","for","that","this","with","you","chewbacca","make",
            "need","should","have","just","into","from","what","bro","also",
            "can","how","its","it's","not","but","are","get","all","out"}
    rows, seen = [], set()
    for line in store.read_text(encoding="utf-8").splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        said = (row.get("said") or "").strip()
        if len(said) < 12:
            continue
        key = said[:70].lower()
        if key in seen:
            continue
        seen.add(key)
        words = [w for w in re.findall(r"[a-z][a-z0-9'-]{3,}", said.lower())
                 if w not in stop]
        if not words:
            continue
        hits = sum(1 for w in set(words) if w in text)
        if hits / len(set(words)) < 0.45:
            rows.append((row.get("at", "")[:16], said))
    if not rows:
        print("  every captured request is mentioned in the backlog")
        return 0
    print(f"\n  Asked and not yet an item ({len(rows)}):")
    for at, said in rows[-limit:]:
        one = " ".join(said.split())
        print(f"    {at}  {one[:104]}")
    print(f"\n  Triage into BACKLOG.md by hand. This is an inbox, not the list.\n")
    return 0


def main():
    arg = (sys.argv[1] if len(sys.argv) > 1 else "").lower()
    secs = sections()

    if arg == "inbox":
        return inbox()

    if not arg:
        n = 0
        for title, lines in secs:
            if title.lower() == "now":
                n += show(title, lines)
        if n:
            print(f"\n  {n} open now. `backlog all` for the rest, BACKLOG.md for detail.\n")
        return 0

    if arg in ("all", "done", "dead", "next"):
        want = {"all": None}.get(arg, arg)
        for title, lines in secs:
            if want is None or want in title.lower():
                show(title, lines)
        print()
        return 0

    hits = 0
    for title, lines in secs:
        keep = [l for l in lines if arg in l.lower()]
        if keep:
            hits += show(f"{title} (matching '{arg}')", keep)
    if not hits:
        print(f"  nothing matching '{arg}'")
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
