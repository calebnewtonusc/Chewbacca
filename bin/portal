#!/bin/bash
# Open a portal onto something on this Mac.
#
#   portal open --app Notes      arm it, then pinch and draw a circle
#   portal open --url <url>      opens the page, portal frames that window
#   portal open                  a plain portal, opening onto nothing
#   portal close                 disarm and quit
#   portal status                is it running, and what is it armed with
#
# WHAT ARMED MEANS. An unarmed portal is a void: a dark disc with a burning
# rim. An armed one PUNCHES A HOLE in the glass, and the app's own window is
# moved to sit behind it. Nothing is captured and nothing is composited; you
# are looking at the real window through a gap, so it is live and has no
# latency by construction.
#
# The target is a file rather than an argument because the portal is usually
# already running when it gets armed. Drawing the circle is the trigger, so
# arming has to be something you can do to a live process.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="$ROOT/hud/build/Portal.app"
TARGET="$HOME/.chewbacca/portal-target"
mkdir -p "$(dirname "$TARGET")"

running() { pgrep -f "Portal.app/Contents/MacOS/Portal" >/dev/null 2>&1; }

case "${1:-status}" in
  open)
    shift
    app=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --app) app="${2:-}"; shift 2 ;;
        --url)
          # A page is just an app window once it is open, so the same
          # placement path handles it. Whatever owns http is what gets framed.
          url="${2:-}"; shift 2
          open "$url"
          sleep 1
          app="$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null || echo "Google Chrome")"
          ;;
        *) echo "portal: unknown flag $1" >&2; exit 64 ;;
      esac
    done
    printf '%s' "$app" > "$TARGET"
    if ! running; then
      [ -d "$APP" ] || { echo "portal: $APP is not built. Run hud/scripts/bundle-portal.sh" >&2; exit 1; }
      open "$APP"
      # The app polls the target file every 250ms, so it picks up whatever
      # was written above without being told twice.
      sleep 1
    fi
    if [ -n "$app" ]; then
      echo "Portal armed for $app. Pinch and draw a circle."
    else
      echo "Portal open. Pinch and draw a circle."
    fi
    ;;
  close)
    : > "$TARGET"
    pkill -f "Portal.app/Contents/MacOS/Portal" 2>/dev/null || true
    echo "Portal closed."
    ;;
  status)
    if running; then
      t="$(cat "$TARGET" 2>/dev/null || true)"
      [ -n "$t" ] && echo "running, armed for $t" || echo "running, unarmed"
    else
      echo "not running"
    fi
    ;;
  *)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 64
    ;;
esac
