#!/bin/bash
# Open a portal onto something on this Mac.
#
#   portal open dashboard        a NAMED target, the normal way in
#   portal targets               what the names are
#   portal open --app Notes      an app by name
#   portal open --url <url>      a page; the portal frames that window
#   portal open                  a plain portal, opening onto nothing
#   portal gain 0.4              how much the portal follows your head, 0 to 1
#   portal size 0.3              how big it is next to the circle you drew
#   portal reach 0.4             how far from centre your hand can push it
#   portal close                 disarm and quit
#   portal status                is it running, and what is it armed with
#
# WHAT ARMED MEANS. An unarmed portal is a void: a dark disc with a burning
# rim. An armed one PUNCHES A HOLE in the glass, and the app's own window is
# moved to sit behind it. Nothing is captured and nothing is composited; you
# are looking at the real window through a gap, so it is live and has no
# latency by construction.
#
# The target is a file rather than an argument because the portal is usually
# already running when it gets armed. Drawing the circle is the trigger, so
# arming has to be something you can do to a live process.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="$ROOT/hud/build/Portal.app"
TARGET="$HOME/.chewbacca/portal-target"
GAIN="$HOME/.chewbacca/portal-gain"
SIZE="$HOME/.chewbacca/portal-size"
REACH="$HOME/.chewbacca/portal-reach"
mkdir -p "$(dirname "$TARGET")"

running() { pgrep -f "Portal.app/Contents/MacOS/Portal" >/dev/null 2>&1; }

# Named targets, so nothing upstream ever has to work out what a word means.
#
# THE FAILURE THIS EXISTS FOR, 2026-09-21. Asked to "open a portal to
# dashboard", the voice agent spent 68 seconds cloning OpenVision, grepping
# the second brain and reading two design docs, because "dashboard" resolved
# to nothing and it went looking. A lookup table is the fix. An agent that
# has to INFER a target will always find something expensive to do, and the
# cheapest way to make it fast is to leave it nothing to infer.
TARGETS="${CHEWBACCA_PORTAL_TARGETS:-$HOME/.chewbacca/portal-targets.tsv}"

resolve() {
  [ -f "$TARGETS" ] || return 1
  awk -F'\t' -v want="$(printf '%s' "$1" | tr 'A-Z' 'a-z')" '
    /^#/ || NF < 3 { next }
    tolower($1) == want { print $2 "\t" $3; found = 1; exit }
    END { exit !found }
  ' "$TARGETS"
}

frontmost() {
  osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null || echo ""
}

list_targets() {
  [ -f "$TARGETS" ] || { echo "no targets file at $TARGETS" >&2; return 1; }
  awk -F'\t' '!/^#/ && NF >= 3 { printf "%-12s %-5s %s\n", $1, $2, $3 }' "$TARGETS"
}

case "${1:-status}" in
  targets)
    list_targets
    ;;
  open)
    shift
    app=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --app) app="${2:-}"; shift 2 ;;
        --url)
          # A page is just a window once it is open, so the same placement
          # path handles it. Whatever owns the URL is what gets framed.
          open "${2:-}"; sleep 1
          app="$(frontmost)"
          shift 2
          ;;
        --*)
          echo "portal: unknown flag $1" >&2; exit 64 ;;
        *)
          # A bare word is a NAMED TARGET. Resolving here means no caller
          # ever has to work out whether it is an app, a page or a file.
          if hit="$(resolve "$1")"; then
            kind="$(printf '%s' "$hit" | cut -f1)"
            tgt="$(printf '%s' "$hit" | cut -f2-)"
            case "$kind" in
              app) app="$tgt" ;;
              url|file) open "$tgt"; sleep 1; app="$(frontmost)" ;;
              *) echo "portal: target '$1' has unknown kind '$kind'" >&2; exit 1 ;;
            esac
          else
            echo "portal: no target named '$1'. Known:" >&2
            list_targets >&2
            exit 1
          fi
          shift
          ;;
      esac
    done

    printf '%s' "$app" > "$TARGET"
    if ! running; then
      [ -d "$APP" ] || { echo "portal: $APP is not built. Run hud/scripts/bundle-portal.sh" >&2; exit 1; }
      open "$APP"
      # The app polls the target file every 250ms, so it picks up whatever
      # was written above without being told twice.
      sleep 1
    fi
    if [ -n "$app" ]; then
      echo "Portal armed for $app. Pinch and draw a circle."
    else
      echo "Portal open. Pinch and draw a circle."
    fi
    ;;
  gain)
    # 0 puts the portal exactly where the camera sees your fingers. 1 casts
    # the full eye-through-fingertip ray, whose gain is about 2.4, which
    # pushes it off the edges of the screen. The default is deliberately low;
    # raise it until it feels right.
    if [ -z "${2:-}" ]; then
      echo "gain: $(cat "$GAIN" 2>/dev/null || echo 0.25)"
      exit 0
    fi
    printf '%s' "$2" > "$GAIN"
    echo "Parallax gain set to $2. It takes effect within a quarter second."
    ;;
  size)
    # Your arm sweeps a much wider arc than the hole you want on screen, so
    # this is well under 1. Lower is smaller.
    if [ -z "${2:-}" ]; then
      echo "size: $(cat "$SIZE" 2>/dev/null || echo 0.45)"
      exit 0
    fi
    printf '%s' "$2" > "$SIZE"
    echo "Portal size set to $2. It takes effect within a quarter second."
    ;;
  reach)
    # 1 maps the camera's whole field to the whole display, which runs off
    # both edges on a normal arm sweep. Lower pulls everything toward the
    # middle: less of the screen reachable, none of it off it.
    if [ -z "${2:-}" ]; then
      echo "reach: $(cat "$REACH" 2>/dev/null || echo 0.5)"
      exit 0
    fi
    printf '%s' "$2" > "$REACH"
    echo "Reach set to $2. It takes effect within a quarter second."
    ;;
  close)
    : > "$TARGET"
    pkill -f "Portal.app/Contents/MacOS/Portal" 2>/dev/null || true
    echo "Portal closed."
    ;;
  status)
    if running; then
      t="$(cat "$TARGET" 2>/dev/null || true)"
      [ -n "$t" ] && echo "running, armed for $t" || echo "running, unarmed"
    else
      echo "not running"
    fi
    ;;
  *)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 64
    ;;
esac
