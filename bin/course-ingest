#!/usr/bin/env bash
# course-ingest: read a Blackboard Ultra term into data and onto the calendar.
# The procedure lives in procedures/course-ingest; this is its name on PATH.
DIR="$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)/procedures/course-ingest"
[ -d "$DIR/node_modules/playwright" ] || (cd "$DIR" && npm i --silent --no-audit --no-fund >/dev/null 2>&1)
exec node "$DIR/run.mjs" "$@"
