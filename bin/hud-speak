#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.10,<3.13"
# dependencies = [
#   "mlx-audio",
#   "misaki[en]",
#   "spacy<3.9",
#   "soundfile",
#   "numpy",
#   "en_core_web_sm @ https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl",
# ]
# ///
"""Read lines aloud with Kokoro, on this Mac, with the model kept warm.

`say` was the first voice the display had and it sounded like 2005. The Mac's
better voices (Ava, Zoe, Samantha Enhanced) cannot be installed from a script,
only by clicking through System Settings, and there is no API key on this
machine for a hosted voice. Kokoro is the 82M-parameter open model that sits
at the top of the small-model listening tests, and on an M4 Pro through MLX it
makes 5.5 seconds of speech in 0.9 seconds once warm. The first sentence after
load costs about six seconds of compilation, which is why this is a server
rather than a command: hud-listen starts it once and keeps it.

One JSON object per line on stdin:

    {"say": "Booked. Call with Caleb tomorrow at three."}
    {"hush": true}

`say` cuts off whatever is still being said and speaks the new text, one
sentence at a time so the first one starts before the rest is made. `hush`
stops it. "ready" on stdout means the model is loaded and warm.

While it plays, one JSON object per line goes back out on stdout, so the
display can move with the voice the way it moves with the person's:

    {"level": 0.62}     twenty times a second, 0 to 1, how loud right now
    {"quiet": true}     nothing more is coming for this `say`

    hud-speak --say "Hello"       speak once and exit, for trying a voice
    hud-speak --voice af_bella    another voice; af_heart is the default
    hud-speak --volume 0.5        quieter; 0 plays silently, for testing
    hud-speak --list              the voices this model ships

Needs `brew install espeak-ng`: Kokoro's English front end falls back to it
for words outside its dictionary, which is every name it has not seen, and
without it those words are dropped silently.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path
from queue import Queue

# espeak-ng comes from Homebrew, and the loader Kokoro's front end ships looks
# for it somewhere that only exists on the wheel builder's machine. Point it at
# Homebrew before anything imports it.
_prefix = os.environ.get("HOMEBREW_PREFIX") or (
    "/opt/homebrew" if Path("/opt/homebrew/bin/brew").exists() else "/usr/local"
)
os.environ.setdefault("ESPEAK_DATA_PATH", f"{_prefix}/share/espeak-ng-data")
os.environ.setdefault("PHONEMIZER_ESPEAK_LIBRARY", f"{_prefix}/lib/libespeak-ng.dylib")
if not Path(os.environ["PHONEMIZER_ESPEAK_LIBRARY"]).exists():
    print("hud-speak: espeak-ng not found; names may be skipped. brew install espeak-ng",
          file=sys.stderr, flush=True)

MODEL = "mlx-community/Kokoro-82M-bf16"
RATE = 24_000
# Short lines are kept once made. "Done.", "Sent.", "Checking your
# calendar." and the rest of the closed set an assistant says all day come
# back from disk instead of the model: a read of a 40 KB wav against a
# generation measured at 160 to 260 ms on 2026-09-20. Eight words is the
# guess at where a line stops being one of the same few; never measured.
CACHE = Path.home() / ".bob" / "voice-cache"
CACHE_WORDS = 8
# Beyond this the oldest go. Fifty kilobytes a line, so this is about
# twenty five megabytes. Guessed, never measured.
CACHE_FILES = 500
# Sentence ends. Splitting here is what lets the first sentence start playing
# while the second is still being made; a whole reply generated first added
# most of a second before anything was heard.
SENTENCE = re.compile(r"(?<=[.!?])\s+")
# How often a level line goes out. 50ms is the frame the ring animates its
# stroke over (PresenceRing: linear 0.06s), so a coarser envelope would step
# and a finer one would be thrown away. Guessed against that, never measured.
FRAME = 0.05
# How long afplay takes to open a file and make sound, so the envelope is not
# ahead of the voice. Guessed, never measured.
LEAD = 0.06


def sentences(text: str) -> list[str]:
    parts = [p.strip() for p in SENTENCE.split(text.strip()) if p.strip()]
    out: list[str] = []
    for part in parts:
        # A two-word fragment is not worth its own generation call and pause.
        if out and len(part.split()) < 3:
            out[-1] = f"{out[-1]} {part}"
        else:
            out.append(part)
    return out


def cache_path(voice: str, speed: float, text: str) -> Path | None:
    """Where a short line's sound lives, or None for a line too long to keep.

    The key carries the model, the voice and the speed, because a cached
    "Done." in another voice is the wrong voice, and it is a hash rather
    than the words because the words are the person's business and a
    directory listing is not.
    """
    if len(text.split()) > CACHE_WORDS:
        return None
    key = hashlib.sha1(f"{MODEL}|{voice}|{speed}|{text}".encode("utf-8")).hexdigest()
    return CACHE / f"{key}.wav"


def trim_cache(limit: int = CACHE_FILES) -> None:
    """Drop the oldest lines once the cache is past `limit` files."""
    try:
        files = sorted(CACHE.glob("*.wav"), key=lambda f: f.stat().st_mtime)
    except OSError:
        return
    for stale in files[: max(0, len(files) - limit)]:
        stale.unlink(missing_ok=True)


def envelope(samples, rate: int = RATE) -> list[float]:
    """How loud each FRAME of `samples` is, 0 to 1.

    RMS per frame against the loudest frame of the same clip, so every
    sentence uses the whole range of the ring however softly it was said,
    then raised to 0.7 so the dips between words stay visible instead of
    flattening into the vowels. The curve is guessed against the eye, never
    measured.
    """
    import numpy as np

    width = max(1, int(rate * FRAME))
    frames = len(samples) // width
    if frames == 0:
        return []
    block = np.asarray(samples[: frames * width], dtype=np.float32).reshape(frames, width)
    rms = np.sqrt(np.mean(block * block, axis=1))
    peak = float(rms.max())
    if peak <= 1e-4:
        return [0.0] * frames
    return [float(v) for v in np.clip(rms / peak, 0.0, 1.0) ** 0.7]


class Player:
    """Plays wav files in order, and drops everything on a hush.

    `generation` is bumped by `hush`; anything queued under an older number is
    skipped when it comes up, which is how a reply that was half-made when the
    person spoke again never reaches the speaker.

    A `None` path is the end of one `say`: everything queued before it has
    played, and `emit` is told quiet. While a file plays its envelope goes to
    `emit` one frame at a time, on the clock, so the display can move with
    the voice.
    """

    def __init__(self, emit=None, volume: float = 1.0) -> None:
        # (path, generation, envelope, sentence, keep). A None path is the
        # end of one say; the sentence rides along so the display can be
        # told which words are starting to play; `keep` is a cached line,
        # left on disk after it plays.
        self.queue: Queue[tuple[str | None, int, list[float], str, bool]] = Queue()
        self.generation = 0
        self.current: subprocess.Popen[bytes] | None = None
        self.lock = threading.Lock()
        self.emit = emit or (lambda message: None)
        self.volume = volume
        threading.Thread(target=self._loop, daemon=True).start()

    def _loop(self) -> None:
        while True:
            path, generation, levels, sentence, keep = self.queue.get()
            try:
                if generation != self.generation:
                    continue
                if path is None:
                    self.emit({"quiet": True})
                    continue
                with self.lock:
                    if generation != self.generation:
                        continue
                    # The words about to be heard, for the subtitle, sent
                    # before the sound starts so the pill is never behind
                    # the voice.
                    self.emit({"saying": sentence})
                    self.current = subprocess.Popen(
                        ["afplay", "-v", str(self.volume), path],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    )
                self._follow(self.current, generation, levels)
            finally:
                if path is not None and not keep:
                    Path(path).unlink(missing_ok=True)
                self.queue.task_done()

    def _follow(self, proc: subprocess.Popen[bytes], generation: int, levels: list[float]) -> None:
        start = time.monotonic() + LEAD
        for i, level in enumerate(levels):
            delay = start + i * FRAME - time.monotonic()
            if delay > 0:
                time.sleep(delay)
            if proc.poll() is not None or generation != self.generation:
                break
            self.emit({"level": round(level, 2)})
        proc.wait()
        if generation != self.generation:
            # Cut off. Nothing queued under this generation will play, so the
            # end-of-say marker never comes; say it here instead.
            self.emit({"quiet": True})
        else:
            # Between sentences, while the next one is still being made: the
            # voice is not gone, it is between words.
            self.emit({"level": 0.0})

    def hush(self) -> int:
        with self.lock:
            self.generation += 1
            if self.current is not None and self.current.poll() is None:
                self.current.terminate()
            return self.generation


class Speaker:
    """Makes the sound, on one worker, in the order it was asked for.

    A reply used to arrive whole and be split here. Now hud-listen hands it
    over a sentence at a time as the model writes it (`say` for the first,
    `add` for the rest, `end` when the reply is complete), so the first
    sentence of a long answer is heard while the last is still being
    written. One worker thread rather than a thread per message, because
    two threads synthesising two sentences race for the player's queue and
    the second sentence can land first.
    """

    def __init__(self, voice: str, speed: float, emit=None, volume: float = 1.0) -> None:
        from mlx_audio.tts.utils import load_model

        self.voice = voice
        self.speed = speed
        self.model = load_model(MODEL)
        self.player = Player(emit, volume)
        self.tmp = Path(tempfile.mkdtemp(prefix="hud-speak-"))
        # (kind, generation, text): "text" to synthesise and queue, "end"
        # to mark the end of the say. A job whose generation has passed is
        # dropped: a hush arrived after it was queued.
        self.jobs: Queue[tuple[str, int, str]] = Queue()
        threading.Thread(target=self._work, daemon=True).start()

    def synthesize(self, text: str, cache: bool = True) -> tuple[str, list[float], bool]:
        """The sound of `text`: its path, its envelope, and whether the
        file is a cached one to leave in place. Short lines come from and
        go to the cache (see `cache_path`); `cache=False` makes the sound
        regardless, for the warm-up."""
        import numpy as np
        import soundfile as sf

        kept = cache_path(self.voice, self.speed, text) if cache else None
        if kept is not None and kept.is_file():
            try:
                samples, _ = sf.read(str(kept), dtype="float32")
                return str(kept), envelope(samples), True
            except (OSError, RuntimeError):
                pass
        chunks = [
            np.array(r.audio)
            for r in self.model.generate(text=text, voice=self.voice, speed=self.speed)
        ]
        samples = np.concatenate(chunks)
        if kept is not None:
            try:
                CACHE.mkdir(parents=True, exist_ok=True)
                sf.write(str(kept), samples, RATE)
                trim_cache()
                return str(kept), envelope(samples), True
            except OSError:
                pass
        path = self.tmp / f"{os.getpid()}-{threading.get_ident()}-{abs(hash(text))}.wav"
        sf.write(str(path), samples, RATE)
        return str(path), envelope(samples), False

    def warm(self) -> None:
        # The first generation after load carries the compilation cost.
        # Paying it here, before "ready", is what makes the first spoken
        # line land in under half a second. Never from the cache, which
        # would skip the compilation this exists to pay.
        Path(self.synthesize("Ready.", cache=False)[0]).unlink(missing_ok=True)

    def say(self, text: str, more: bool = False) -> None:
        """A reply, cutting off what was playing. Whole, quiet follows it on
        its own; with `more` to come, quiet waits for `end`."""
        generation = self.player.hush()
        self.jobs.put(("text", generation, text))
        if not more:
            self.jobs.put(("end", generation, ""))

    def add(self, text: str) -> None:
        """More of the reply being said. Queued behind what is already there."""
        self.jobs.put(("text", self.player.generation, text))

    def end(self) -> None:
        """The reply is complete: quiet follows the last sentence."""
        self.jobs.put(("end", self.player.generation, ""))

    def _work(self) -> None:
        while True:
            kind, generation, text = self.jobs.get()
            try:
                if generation != self.player.generation:
                    continue
                if kind == "end":
                    self.player.queue.put((None, generation, [], "", False))
                    continue
                for sentence in sentences(text):
                    if generation != self.player.generation:
                        break
                    path, levels, keep = self.synthesize(sentence)
                    self.player.queue.put((path, generation, levels, sentence, keep))
            finally:
                self.jobs.task_done()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--voice", default=os.environ.get("HUD_VOICE", "af_heart"))
    parser.add_argument("--speed", type=float, default=1.0)
    parser.add_argument("--volume", type=float, default=1.0, help="afplay volume, 0 to 1")
    parser.add_argument("--say", help="speak this once and exit")
    parser.add_argument("--list", action="store_true", help="list the voices")
    args = parser.parse_args()

    if args.list:
        from huggingface_hub import snapshot_download

        voices = sorted(Path(snapshot_download(MODEL)).glob("voices/*.safetensors"))
        for v in voices:
            print(v.stem)
        return 0

    if args.say:
        speaker = Speaker(args.voice, args.speed, volume=args.volume)
        speaker.warm()
        speaker.say(args.say)
        # Wait for the worker to make every sentence, then for the last one
        # to finish playing, rather than exiting mid-sentence.
        speaker.jobs.join()
        speaker.player.queue.join()
        return 0

    out = threading.Lock()

    def emit(message: dict) -> None:
        with out:
            print(json.dumps(message), flush=True)

    speaker = Speaker(args.voice, args.speed, emit, args.volume)
    speaker.warm()
    print("ready", flush=True)

    def follow_parent() -> None:
        # hud-listen is the only thing that talks to this process, and when
        # it is killed the pipe does not always close: uv sits between the
        # two and keeps the read end open. Two of these were found running
        # after two bridge restarts on 2026-09-19, each holding the model.
        while True:
            time.sleep(2)
            if os.getppid() == 1:
                os._exit(0)

    threading.Thread(target=follow_parent, daemon=True).start()
    for raw in sys.stdin:
        try:
            message = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if message.get("hush"):
            speaker.player.hush()
            continue
        if message.get("end"):
            speaker.end()
            continue
        # Both only queue a job; the worker makes the sound, so a hush on
        # the next line is read while this one is still being made.
        text = str(message.get("say") or "").strip()
        if text:
            speaker.say(text, more=bool(message.get("more")))
        more = str(message.get("add") or "").strip()
        if more:
            speaker.add(more)
    return 0


if __name__ == "__main__":
    sys.exit(main())
