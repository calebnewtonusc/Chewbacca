#!/usr/bin/env python3
"""ux-do: do what was meant in the window in front, by Jev, without the mouse.

    ux-do "open the about page"                      the frontmost app
    ux-do "turn on dark mode" --app "System Settings"
    ux-do "search box" --type "flights to Tokyo"     type into what it finds
    ux-do "the about link" --dry                     choose, report, press nothing

Prints one JSON line. status: done (pressed, and the window shows it), no change (pressed, nothing happened), would act, ask (two candidates, the voice
asks which), yours to press (a send, payment, delete or submit, found and not
pressed), not found, error. Exit 0 on done or would act, 1 otherwise.
"""
import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import ux  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("intent")
    ap.add_argument("--app")
    ap.add_argument("--type", dest="text")
    ap.add_argument("--dry", action="store_true")
    args = ap.parse_args()
    result = ux.do(args.intent, app=args.app, text=args.text, dry=args.dry)
    print(json.dumps(result))
    return 0 if result["status"] in ("done", "would act") else 1


if __name__ == "__main__":
    sys.exit(main())
