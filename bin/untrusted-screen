#!/usr/bin/env python3
"""untrusted-screen: does this text talk to the agent reading it?

    untrusted-screen [--source LABEL] [FILE]      reads stdin when FILE is absent

Prints one JSON line. Exit 1 when flagged, 0 when not, so a caller can gate
on it. A Jev flag is a judgment: callers warn on it, they do not refuse.
"""
import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import screen  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("file", nargs="?")
    parser.add_argument("--source", default="")
    args = parser.parse_args()
    text = Path(args.file).read_text(errors="replace") if args.file else sys.stdin.read()
    result = screen.screen(text)
    if args.source:
        result["source"] = args.source
    print(json.dumps(result))
    return 1 if result["flagged"] else 0


if __name__ == "__main__":
    sys.exit(main())
