#!/usr/bin/env python3
"""Caleb's patterns, not generic AI-isms.

ai-scan gave DRAFT-1.md a clean bill while it carried six kickers, three
not-X-but-Y constructions, two announced turns and two dramatic fragments.
ai-scan detects delve/tapestry/robust. It does not know what Caleb hates.
This does. Source of truth: ~/second-brain/core/voice.md, the fifteen
corrections from the 180DC night.

  ./slopcheck.py <file>...      exit 1 if anything fires
"""
import re, sys, pathlib

# (label, regex, why)
RULES = [
    ("announced-turn", r"(?i)\b(here'?s what|what i (?:had|got) (?:wrong|backwards)|that (?:is|'s) when i (?:understood|realized)|this is the part where|here'?s the thing)\b",
     "Announcing the turn instead of turning. Delete it, let the next sentence work."),
    ("not-x-but-y", r"(?i)((?:it|that|the (?:point|question|difference|problem|answer))'?s? (?:is )?not\b[^.\n]{0,60}\bit'?s\b)|(\bnot the other way around\b)|(\bisn'?t (?:about )?[a-z ]{1,30}, it'?s\b)",
     "The 'it's not X, it's Y' shape. State Y."),
    ("metadiscourse", r"(?i)\b(which is the whole point|that matters more than it sounds|the key point is|as you can see|what i'?m trying to say|somehow better than)\b",
     "Telling the reader how to read it. Cut the aside."),
    ("summary-ending", r"(?i)^\s*(in conclusion|ultimately|overall|at the end of the day|all in all)\b",
     "Summary-recap ending."),
    ("throat-clearing", r"(?i)^\s*(let me be clear|to be honest|to be fair|the reality is|it'?s worth noting)\b",
     "Throat-clearing. Open on the point."),
    ("faux-insight", r"(?i)\b(what nobody tells you|the part everyone misses|most people get this wrong|nobody talks about)\b",
     "Faux-insight setup. Make the claim stand alone."),
    ("banned-word", r"(?i)\b(delve|foster|leverage|utilize|facilitate|empower|streamline|robust|seamless|cutting-edge|game changer|paradigm shift|transformative|elevate|harness|meticulous|intricate|realm|tapestry|ever-evolving)\b",
     "Banned word."),
    ("em-dash", r"—", "Em dash. Use a colon, period, or comma."),
    ("ing-clause", r", (?:highlighting|underscoring|showcasing|demonstrating|reflecting|emphasizing|showing) (?:the|his|her|their|its|a|an)\b",
     "Superficial -ing clause."),
    ("importance-puffery", r"(?i)\b(a testament to|marks a pivotal|underscores the|speaks volumes)\b",
     "Importance puffery."),
]

# --chat only. These are register tells, not prose tells: they fire on a reply
# that reads like a well-edited assistant rather than like Caleb. They are
# separated because a header or a table is correct in a document and wrong in
# a chat reply, so running them on files would be noise.
#
# Added 2026-09-20 after he caught "Same brief, same stance, same model" and
# asked why the guard let it through. It let it through because slop-check
# scored the reply 0 and prose-check had no concept of register at all:
# voice.md was loaded every session and enforced by nothing.
CHAT_RULES = [
    ("balanced-triple", r"(?i)\b(\w+) \w+, \1 \w+, \1 \w+\b",
     "Anaphoric triple ('same X, same Y, same Z'). voice.md: balanced parallel "
     "points are the generated tell. Lean on one and let the rest trail."),
    ("chat-header", r"(?m)^#{1,6} \S",
     "A markdown header in a chat reply. Right for a document, wrong here."),
    ("chat-table", r"(?m)^\|.*\|",
     "A table in a chat reply. Three sentences, or send it as a file."),
    ("offer-ending", r"(?i)(want me to\b|let me know if\b|say the word\b|"
     r"happy to\b|shall i\b|would you like me to\b)",
     "Offering next steps as a reflex ending. Offer at a real fork, not every turn."),
]


def bold_scaffolding(text):
    """Bold used as paragraph scaffolding rather than as emphasis."""
    import re as _re
    starts = _re.findall(r"(?m)^\*\*[^*\n]{3,60}\*\*", text)
    if len(starts) >= 3:
        return [("bold-scaffolding", starts[0],
                 f"{len(starts)} paragraphs opening in bold. If every paragraph "
                 f"starts bold, none of it is emphasis. voice.md: bold only a "
                 f"load-bearing fact.")]
    return []


def formal_constructions(text):
    """He runs heavily contracted. Assistant drafts invert this."""
    import re as _re
    formal = _re.findall(
        r"(?i)\b(do not|does not|did not|cannot|can not|will not|is not|are not|"
        r"it is|that is|there is|I am|you are|we are|they are|would not|should not)\b",
        text)
    if len(formal) >= 4:
        return [("formal-register", ", ".join(sorted(set(formal))[:5]),
                 f"{len(formal)} formal constructions. His measured ratio is "
                 f"74 contractions to 4 formal. Use don't, can't, it's.")]
    return []


# Fragments under N words on their own sentence, stacked back to back.
def dramatic_fragments(text):
    hits = []
    for para in text.split("\n\n"):
        flat = " ".join(para.split())
        sents = [s.strip() for s in re.split(r"(?<=[.!?])\s+", flat) if s.strip()]
        run = 0
        for s in sents:
            if len(s.split()) <= 5 and not s.startswith(('"', "'", "#", "-", ">")):
                run += 1
                if run >= 2:
                    hits.append(s)
            else:
                run = 0
    return hits

def kickers(text):
    """A paragraph's last sentence that is short, starts with a conjunction or
    'I', and contains no concrete noun from the paragraph. Heuristic and noisy
    on purpose: it is a prompt to reread, not a verdict."""
    out = []
    for para in text.split("\n\n"):
        flat = " ".join(para.split())
        if flat.startswith(("#", ">", "-", "|")) or len(flat.split()) < 30:
            continue
        sents = [s.strip() for s in re.split(r"(?<=[.!?])\s+", flat) if s.strip()]
        if not sents:
            continue
        last = sents[-1]
        w = last.split()
        if 3 <= len(w) <= 12 and re.match(r"(?i)^(and|but|so|because|that|it|this|i'?m|i |there)\b", last):
            if not re.search(r"\d|\"", last):
                out.append(last)
    return out

def main(paths, chat=False):
    bad = 0
    for p in paths:
        text = pathlib.Path(p).read_text()
        # Never lint the disclosure paragraph; it is required boilerplate.
        text = text.split("## Note on AI use")[0]
        # Skip any MLA/name header above the first markdown title. Not in chat
        # mode: a reply has no title, and stripping to the first "# " would
        # both eat the reply and hide the chat-header rule from itself.
        if not chat:
            m = re.search(r"^# ", text, re.M)
            if m:
                text = text[m.start():]
        found = []
        for label, rx, why in (RULES + CHAT_RULES if chat else RULES):
            for m in re.finditer(rx, text, re.M):
                line = text[:m.start()].count("\n") + 1
                found.append((line, label, m.group(0).strip()[:60], why))
        # dramatic-fragment and possible-kicker are ESSAY rules and they invert
        # in chat. His median sent message is 5 words and 15% of everything he
        # sends is a single word, so stacked short lines are his native
        # register, not a rhythm trick. Running these on a reply would push it
        # toward the paragraph voice this whole mode exists to stop.
        if not chat:
            for f in dramatic_fragments(text):
                found.append((0, "dramatic-fragment", f[:60], "Stacked short sentences for rhythm."))
            for k in kickers(text):
                found.append((0, "possible-kicker", k[:60], "Paragraph ends on a manufactured line. Should end on a plain fact."))
        if chat:
            for label, snip, why in bold_scaffolding(text) + formal_constructions(text):
                found.append((0, label, snip[:60], why))
        if found:
            bad = 1
            print(f"\n{p}: {len(found)} flagged")
            for line, label, snip, why in sorted(found):
                loc = f"L{line}" if line else "  "
                print(f"  {loc:>5}  {label:<18} {snip!r}")
                print(f"         -> {why}")
        else:
            print(f"{p}: clean")
    return bad

if __name__ == "__main__":
    args = [a for a in sys.argv[1:] if a != "--chat"]
    if not args:
        sys.exit(__doc__)
    sys.exit(main(args, chat="--chat" in sys.argv[1:]))
