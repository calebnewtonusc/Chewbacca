# Secrets, never commit
.env
.env.local
.env.*
!.env.example

# Claude local overrides
.claude/settings.local.json

# Node (if any tooling added)
node_modules/

# OS
.DS_Store
Thumbs.db

# Python bytecode from bin/ tools
__pycache__/
*.pyc

# Vendored Plynn build output. Both of them: only .build was listed, so
# DerivedData sat in git status as untracked noise forever.
plynn/.build/
plynn/build/
# Coverage data, dropped in the working directory by `swift test` rather than
# anywhere sensible. Zero bytes and untracked, so it shows up in git status
# after every test run and looks like work.
*.profraw
