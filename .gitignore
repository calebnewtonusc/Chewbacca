# Secrets, never commit
.env
.env.local
.env.*
!.env.example

# Claude local overrides
.claude/settings.local.json

# Node (if any tooling added)
node_modules/

# OS
.DS_Store
Thumbs.db

# Python bytecode from bin/ tools
__pycache__/
*.pyc

# What is said to the voice assistant. Personal, stays on the machine.
superassistant/*.jsonl

# Vendored Plynn build output. Both of them: only .build was listed, so
# DerivedData sat in git status as untracked noise forever.
plynn/.build/
plynn/build/
# Coverage data, dropped in the working directory by `swift test` rather than
# anywhere sensible. Zero bytes and untracked, so it shows up in git status
# after every test run and looks like work.
*.profraw

# Parallel-tab worktrees. CLAUDE.md requires a worktree per concurrent agent,
# and the Stop hook auto-commits, so leaving this untracked means a second
# session's entire checkout can get swept into a commit here.
.worktrees/

# Kits cloned for local use. Chewbacca's own doctrine (skills/kit-builder) says a
# kit is a separate repo discovered by its .kit marker, not vendored here, and
# kits/apply-kit carries its own .git. Left untracked so the Stop auto-commit
# hook cannot sweep an embedded repo into a Chewbacca commit.
kits/

# Swift build artifacts, which bob-the-builder ignored at its root and
# came here without when the hud moved in
hud/.build/
hud/build/

# The Swift voice server's build, same as the display's
voice/.build/

# A2A course material and its pipeline: reference for the second brain,
# not a project to publish.
/asa/
tests/.circle-under-test.mjs
tests/.smooth-under-test.mjs
tests/.portal-state-under-test.mjs
