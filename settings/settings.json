{
  "env": {
    "GITHUB_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN",
    "TODOIST_API_TOKEN": "YOUR_TODOIST_API_TOKEN"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(pip3:*)",
      "Bash(vercel:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(date:*)",
      "Bash(sort:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(diff:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)"
    ],
    "_comment_deny": "setup.sh sets defaultMode to bypassPermissions, so nothing prompts. These are the operations that stay blocked anyway: the ones with no undo, and the reads that would pull a secret into context where it can be echoed back or logged. deny beats allow.",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin*)",
      "Bash(gh repo delete:*)",
      "Bash(dropdb:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "alwaysThinkingEnabled": true,
  "hooks": {
    "_comment": "Hook logic lives in ~/.claude/hooks/*.sh, not in escaped one-liners here. Both install.sh and setup.sh put them there. Editing a shell script beats editing a JSON string with seven levels of backslash escaping.",
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-context.sh",
            "statusMessage": "Loading your context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-and-sync.sh",
            "statusMessage": "Formatting and syncing...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-check.sh",
            "statusMessage": "Checking for unpushed work..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/env-guard.sh",
            "statusMessage": "Checking file safety..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/coursework-context.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/kit-route.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
