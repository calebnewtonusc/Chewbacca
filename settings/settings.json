{
  "env": {
    "GITHUB_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN",
    "TODOIST_API_TOKEN": "YOUR_TODOIST_API_TOKEN"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(pip3:*)",
      "Bash(vercel:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(date:*)",
      "Bash(sort:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(diff:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)"
    ],
    "_comment_deny": "setup.sh sets defaultMode to bypassPermissions, so nothing prompts. These are the operations that stay blocked anyway: the ones with no undo, the ones that turn off a macOS protection, the reads that pull a secret into context where it can be echoed back or logged, and piping a download straight into a shell. deny beats allow. This is a string match, not a sandbox: see docs/THREAT-MODEL.md for what it does not cover.",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin*)",
      "Bash(gh repo delete:*)",
      "Bash(dropdb:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -rf \"$HOME\")",
      "Bash(rm -rf /Users)",
      "Bash(rm -rf /Users/*)",
      "Bash(rm -fr:*)",
      "Bash(rm --recursive --force:*)",
      "Bash(sudo rm -rf:*)",
      "Bash(sudo dd:*)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(mkfs:*)",
      "Bash(diskutil eraseDisk:*)",
      "Bash(diskutil eraseVolume:*)",
      "Bash(chmod -R 777 /)",
      "Bash(chown -R:* /)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git reflog expire:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh auth token)",
      "Bash(security dump-keychain:*)",
      "Bash(security find-generic-password:*)",
      "Bash(defaults delete:*)",
      "Bash(launchctl bootout system:*)",
      "Bash(csrutil disable)",
      "Bash(spctl --master-disable)",
      "Bash(tccutil reset All)",
      "Bash(curl:* | bash)",
      "Bash(curl:* | sh)",
      "Bash(wget:* | bash)",
      "Bash(history)",
      "Bash(cat ~/.zsh_history)",
      "Bash(cat ~/.bash_history)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/Library/Keychains/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.chewbacca/people/**.db)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "alwaysThinkingEnabled": true,
  "hooks": {
    "_comment": "Hook logic lives in ~/.claude/hooks/*.sh, not in escaped one-liners here. Both install.sh and setup.sh put them there. Editing a shell script beats editing a JSON string with seven levels of backslash escaping.",
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-context.sh",
            "statusMessage": "Loading your context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-and-sync.sh",
            "statusMessage": "Formatting and syncing...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-check.sh",
            "statusMessage": "Checking for unpushed work..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/env-guard.sh",
            "statusMessage": "Checking file safety..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/coursework-context.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/kit-route.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
