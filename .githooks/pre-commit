#!/bin/bash
# Refuse a commit whose index contains ANOTHER session's staged work.
#
# THE FAILURE THIS EXISTS FOR, 2026-09-20. Two Claude sessions ran in this
# repo the same day. A handoff note warned in writing: "Stage by filename,
# never git add -A. Two sessions ran in this repo today and one commit already
# absorbed the other's files under an unrelated message."
#
# The next commit did it again. Commit a99042a, about methods/, swallowed
# README.md, setup.sh and SHA256SUMS.txt from the other session.
#
# STAGING BY FILENAME DOES NOT PREVENT THIS. `git add <my files>` is careful
# and irrelevant, because `git commit` commits the whole index and the other
# session's files were already in it, staged hours earlier.
#
# The real fixes are `git commit -- <paths>`, which commits only those paths,
# or this hook. Use both.
#
# HOW GOOD IS THIS, HONESTLY. The heuristic is staged files whose mtime is far
# older than the newest staged file. It catches a tab that closed hours ago,
# which is the case that happened. It does NOT catch a file regenerated
# moments ago by a build step, which is how SHA256SUMS.txt slipped through
# even after this hook existed.
#
# So this is a backstop, not the fix. The fix is a habit:
#
#     git commit -- path/one path/two
#
# which commits ONLY those paths regardless of what else sits in the index.
# The hook exists because habits fail at 2am and a printed list does not.
#
# Enable:  git config core.hooksPath .githooks
# Bypass:  ALLOW_STALE_STAGED=1 git commit ...   (say why in the message)
set -uo pipefail
[ -n "${ALLOW_STALE_STAGED:-}" ] && exit 0

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$STAGED" ] || exit 0

# A file the manifest covers, committed without the manifest, breaks install
# verification for everyone: setup.sh checks its downloads against
# SHA256SUMS.txt. It has happened twice, 2026-09-19 and 2026-09-21.
#
# This runs HERE, not at the end of the file. Appended after the last block it
# was unreachable, because every success path exits before then, and a probe
# commit sailed straight through it. A guard that cannot be reached is worth
# less than no guard, because it reads like cover.
if [ -z "${SKIP_MANIFEST_GUARD:-}" ] && [ -f tools/manifest_guard.py ]; then
  python3 tools/manifest_guard.py || exit 1
fi

# ── Concurrent sessions ──────────────────────────────────────────────────────
#
# The mtime heuristic below CANNOT catch the case that keeps happening, and it
# failed again on 2026-09-20 for exactly the reason its own header predicted:
# when two sessions write concurrently, both sets of files are fresh, so
# nothing looks stale. It printed the file list and let 233 lines of another
# session's work through under an unrelated message. Third time in one day,
# and by then it had happened in both directions.
#
# There is no signal in git that says which session staged a path. So this
# does the only honest thing: when more than one agent session is live in this
# checkout, it REFUSES a commit that was not limited with a pathspec, because
# `git commit -- <paths>` is the one mechanism that actually works.
#
# Detection is deliberately crude and errs toward refusing. A false refusal
# costs one retyped command. A false pass costs somebody's work.
#
# DETECTING A PATHSPEC COMMIT, 2026-09-21. The version below refused one,
# and then told the author to do the thing they had just done.
#
# `git commit -- a b` builds a TEMPORARY index holding only those paths and
# runs the hook against it, so from in here a two-file pathspec commit and a
# bare commit of a two-file index are byte for byte identical. The gate fired
# on both. A one-file pathspec commit slipped through only because of the
# `-gt 1` clause, which is why the bug hid: every single-file commit worked
# and the advice looked sound.
#
# Git does distinguish them, in GIT_INDEX_FILE. A bare commit runs against
# `.git/index`; a pathspec commit runs against `.git/next-index-<pid>.lock`.
# A pathspec commit is already the safe form this hook exists to encourage,
# so it is let straight through.
case "$(basename "${GIT_INDEX_FILE:-index}")" in
  next-index*) PATHSPEC_COMMIT=1 ;;
  *)           PATHSPEC_COMMIT=0 ;;
esac

# A merge, cherry-pick or revert is legitimately a whole-index commit and
# CANNOT be a pathspec commit: git forbids a pathspec while one is in
# progress ("fatal: cannot do a partial commit during a merge"). So the
# gate below, which tells the author to name paths, is advice they cannot
# take, and it fired on every merge of upstream/main this session until
# CHEWBACCA_PATHSPEC_COMMIT=1 was set by hand (2026-09-22). The merge tree
# was already resolved and looked at, which is the thing the gate protects,
# so a merge in progress is let through.
GIT_DIR_PATH="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
if [ -f "$GIT_DIR_PATH/MERGE_HEAD" ] || [ -f "$GIT_DIR_PATH/CHERRY_PICK_HEAD" ]    || [ -f "$GIT_DIR_PATH/REVERT_HEAD" ]; then
  PATHSPEC_COMMIT=1
fi

# CHEWBACCA_FAKE_SESSIONS lets the test drive this count; live it is pgrep.
SESSIONS=${CHEWBACCA_FAKE_SESSIONS:-$(pgrep -f "claude" 2>/dev/null | wc -l | tr -d ' ')}
if [ "${SESSIONS:-0}" -gt 1 ] && [ "$PATHSPEC_COMMIT" -eq 0 ] \
   && [ -z "${CHEWBACCA_PATHSPEC_COMMIT:-}" ]; then
  STAGED_N=$(printf '%s\n' "$STAGED" | wc -l | tr -d ' ')
  TRACKED_DIRTY=$(git diff --name-only HEAD | wc -l | tr -d ' ')
  # If the index holds everything that is dirty, this was almost certainly a
  # bare commit. A pathspec commit stages a subset.
  if [ "$STAGED_N" -ge "$TRACKED_DIRTY" ] && [ "$STAGED_N" -gt 1 ]; then
    cat >&2 <<'MSG'

pre-commit: refusing. More than one agent session is live in this checkout and
this is a bare commit, which takes the WHOLE index including anything another
session staged.

That is how three commits on 2026-09-20 swallowed another session's work.
Name your paths instead, which commits only those and is now detected
properly rather than being refused as well:

  git commit -- path/one path/two

If you really do mean the whole index:

  CHEWBACCA_PATHSPEC_COMMIT=1 git commit ...

MSG
    exit 1
  fi
fi

WINDOW=${STALE_STAGED_MINUTES:-45}
NEWEST=0
declare -a TIMES=() NAMES=()
while IFS= read -r f; do
  [ -f "$f" ] || continue
  m=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0)
  [ "$m" -gt "$NEWEST" ] && NEWEST=$m
  TIMES+=("$m"); NAMES+=("$f")
done <<< "$STAGED"

[ "$NEWEST" -gt 0 ] || exit 0
CUTOFF=$(( NEWEST - WINDOW * 60 ))

STALE=""
for i in "${!NAMES[@]}"; do
  if [ "${TIMES[$i]}" -lt "$CUTOFF" ]; then
    STALE="$STALE  ${NAMES[$i]}"$'\n'
  fi
done

# Always print what is about to be committed. The absorbed-files failure was
# invisible both times it happened; a list on stderr makes it visible even
# when the heuristic below does not fire.
printf 'pre-commit: committing %s file(s):\n' "$(printf '%s\n' "$STAGED" | wc -l | tr -d ' ')" >&2
printf '%s\n' "$STAGED" | sed 's/^/  /' >&2

# ── Two live sessions ────────────────────────────────────────────────────────
#
# The mtime heuristic below catches a tab that closed hours ago. It cannot catch
# a session running right now, whose files are as fresh as yours. On 2026-09-20
# commit 4a0b1df absorbed another session's bin/evolve and tests/evolve.sh,
# written minutes earlier, and this hook printed them and let them through.
#
# Authorship is exact where timestamps are not. write-log.sh records the session
# id beside every path a tool writes, so an index holding two authors is a fact
# rather than a guess.
#
# FAILS OPEN on purpose. No log, or paths nobody logged (a hand edit, a build
# step, a human in an editor), and this says nothing and leaves the old
# behaviour exactly as it was.
WRITE_LOG="${CHEWBACCA_WRITE_LOG:-$HOME/.chewbacca/write-log.tsv}"
if [ -s "$WRITE_LOG" ]; then
  MIXED=$(
    { printf '%s\n' "$STAGED"; } | while IFS= read -r f; do
      [ -n "$f" ] || continue
      abs="$(cd "$(dirname "$f")" 2>/dev/null && pwd)/$(basename "$f")"
      sid=$(grep -F "	$abs" "$WRITE_LOG" 2>/dev/null | tail -1 | cut -f2)
      [ -n "$sid" ] && printf '%s\t%s\n' "$sid" "$f"
    done
  )
  SESSIONS=$(printf '%s\n' "$MIXED" | cut -f1 | grep -v '^$' | sort -u | wc -l | tr -d ' ')
  if [ "${SESSIONS:-0}" -gt 1 ]; then
    cat >&2 <<MIXEDMSG

pre-commit: refusing. The index holds files written by $SESSIONS different
sessions. One of them is not yours, and committing it files somebody else's
work under your message.

$(printf '%s\n' "$MIXED" | awk -F'\t' '{printf "  [%s] %s\n", substr($1,1,8), $2}')

Commit only your own paths:

  git commit -- path/one path/two

If they really are all yours:  ALLOW_STALE_STAGED=1 git commit ...
MIXEDMSG
    exit 1
  fi
fi

[ -z "$STALE" ] && exit 0

cat >&2 <<MSG

pre-commit: refusing. The index holds files last touched over ${WINDOW} minutes
before the newest staged file, which usually means another session staged them.

$STALE
Commit only your own paths:

  git commit -- path/one path/two

or unstage theirs:

  git restore --staged <path>

If they really are yours:  ALLOW_STALE_STAGED=1 git commit ...
and say why in the message.
MSG
exit 1
